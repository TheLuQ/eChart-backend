ARG GO_BASE_IMAGE=golang:1.26.1-bullseye
FROM ${GO_BASE_IMAGE} AS go-base

WORKDIR /app
COPY go.mod go.sum /app/
ARG GOPROXY=${GOPROXY:-https://proxy.golang.org,direct}
RUN go mod download

COPY . /app/

RUN go build -o dbseed ./cmd/dbseed

FROM google/cloud-sdk:latest

WORKDIR /app
COPY ./db.json /app/db.json
COPY --from=go-base /app/dbseed /app/

ENV PROJECT_ID=fake-project
ENV DB=sheets
ENV MOCK_DATA_FILE=/app/db.json

CMD gcloud emulators firestore start --host-port=0.0.0.0:8080 & \
    until curl -sf http://localhost:8080; do sleep 1; done && \
    ./dbseed && \
    wait
